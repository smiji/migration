pipeline {
  agent any

  stages {
    stage('JDK matrix') {
      matrix {
        axes {
          axis { name 'JDK'; values 'jdk8', 'jdk17' }
        }
        stages {
          stage('Build, test, smoke') {
            tools {
              jdk "${JDK}"
              maven 'maven3'
            }
            steps {
              dir('legacy-orders') {
                sh 'java -version && mvn -version'
                sh 'mvn -B clean verify'

                sh '''
                  set -eu

                  PORT=$([ "$JDK" = "jdk8" ] && echo 18080 || echo 18017)
                  LOG=app-$JDK.log

                  java -jar target/legacy-orders-1.0.0.jar --server.port=$PORT > "$LOG" 2>&1 &
                  echo $! > "app-$JDK.pid"

                  READY=false
                  for i in $(seq 1 30); do
                    if curl -fsS "localhost:$PORT/actuator/health" 2>/dev/null | grep -q UP; then
                      READY=true
                      break
                    fi

                    if ! kill -0 "$(cat "app-$JDK.pid")" 2>/dev/null; then
                      echo "Application exited before becoming healthy."
                      break
                    fi
                    sleep 2
                  done

                  if [ "$READY" != "true" ]; then
                    echo "Smoke test startup failed for $JDK. Application log:"
                    cat "$LOG"
                    exit 1
                  fi

                  curl -fsS "localhost:$PORT/actuator/health" | grep -q UP
                  curl -fsS -u admin:admin123 "localhost:$PORT/api/orders" | grep -q Asha
                  curl -fsS -u admin:admin123 "localhost:$PORT/api/orders/1/xml" | grep -q '<customerName>'
                  ! grep -E "GenerationTarget encountered exception|APPLICATION FAILED" "$LOG"
                '''
              }
            }
            post {
              always {
                dir('legacy-orders') {
                  sh '''
                    if [ -f "app-$JDK.pid" ]; then
                      kill "$(cat "app-$JDK.pid")" 2>/dev/null || true
                    fi
                  '''
                  junit allowEmptyResults: true, testResults: 'target/surefire-reports/*.xml'
                  archiveArtifacts artifacts: 'app-*.log', allowEmptyArchive: true
                }
              }
            }
          }
        }
      }
    }
  }
}