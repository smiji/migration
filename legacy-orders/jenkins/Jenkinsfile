// Build once on JDK 8, then run the SAME jar on JDK 8 and on JDK 17.
// Sequential stages, so the console log reads top to bottom.
// Tool names must match Manage Jenkins > Tools exactly: jdk8, jdk17, maven3.

pipeline {
  agent any
  stages{
    stage('Build and test (JDK 8)') {
      steps {
        script {
          def jdkHome = tool name: 'jdk8', type: 'hudson.model.JDK'
          def mvnHome = tool name: 'maven3', type: 'hudson.tasks.Maven$MavenInstallation'
          def javaExecutable = sh(
            script: "find '${jdkHome}' -type f -path '*/bin/java' -print -quit",
            returnStdout: true
          ).trim()
          if (!javaExecutable) {
            error "No Java executable found below the Jenkins JDK tool directory: ${jdkHome}"
          }
          def jdkInstallHome = javaExecutable.substring(0, javaExecutable.lastIndexOf('/bin/java'))
          echo "Resolved JDK installation: ${jdkInstallHome}"
          withEnv(["JAVA_HOME=${jdkInstallHome}", "PATH+JDK=${jdkInstallHome}/bin", "PATH+MVN=${mvnHome}/bin"]) {
            dir('legacy-orders') {
              sh '''
                java_version=$(java -version 2>&1 | head -n 1)
                echo "Resolved JAVA_HOME=$JAVA_HOME"
                echo "$java_version"
                case "$java_version" in
                  *'1.8.'*|*' 8.'*) ;;
                  *) echo "Configured Jenkins tool 'jdk8' does not resolve to Java 8." >&2; exit 1 ;;
                esac
                mvn -version
              '''
              sh 'mvn -B clean verify'
            }
          }
        }
      }
      post {
        always {
          junit allowEmptyResults: true, testResults: 'legacy-orders/target/surefire-reports/*.xml'
        }
      }
    }
  }
}