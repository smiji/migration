pipeline {
  agent any

  stages {
    stage('JDK matrix') {
      matrix {
        axes {
          axis { name 'JAVA_TOOL'; values 'jdk8', 'jdk17' }
        }
        stages {
          stage('Build, test, smoke') {
            steps {
              script {
                echo "Preparing ${JAVA_TOOL} build"
                try {
                  def javaHome = tool name: JAVA_TOOL, type: 'jdk'
                  def mavenHome = tool name: 'maven3', type: 'hudson.tasks.Maven$MavenInstallation'
                  echo "Using Java tool: ${javaHome}"
                  echo "Using Maven tool: ${mavenHome}"

                  withEnv(["JAVA_HOME=${javaHome}", "PATH+JAVA=${javaHome}/bin", "MAVEN_HOME=${mavenHome}", "PATH+MAVEN=${mavenHome}/bin"]) {
                    dir('legacy-orders') {
                      echo "Starting ${JAVA_TOOL} build in ${pwd()}"
                      sh 'java -version && mvn -version'
                      echo "Running Maven clean verify for ${JAVA_TOOL}"
                      sh 'mvn -B -e clean verify'

                      sh '''
                        set -eu

                        PORT=$([ "$JAVA_TOOL" = "jdk8" ] && echo 18080 || echo 18017)
                        LOG=app-$JAVA_TOOL.log

                        echo "Starting $JAVA_TOOL application on port $PORT"
                        java -jar target/legacy-orders-1.0.0.jar --server.port=$PORT > "$LOG" 2>&1 &
                        echo $! > "app-$JAVA_TOOL.pid"
                        echo "Application PID: $(cat "app-$JAVA_TOOL.pid")"

                        READY=false
                        for i in $(seq 1 30); do
                          echo "Health check attempt $i/30"
                          if curl -fsS "localhost:$PORT/actuator/health" 2>/dev/null | grep -q UP; then
                            READY=true
                            echo "Application is healthy"
                            break
                          fi

                          if ! kill -0 "$(cat "app-$JAVA_TOOL.pid")" 2>/dev/null; then
                            echo "Application exited before becoming healthy."
                            break
                          fi
                          sleep 2
                        done

                        if [ "$READY" != "true" ]; then
                          echo "Smoke test startup failed for $JAVA_TOOL. Application log:"
                          cat "$LOG"
                          exit 1
                        fi

                        echo "Checking health endpoint"
                        HEALTH=$(curl -fsS "localhost:$PORT/actuator/health") || {
                          echo "Health endpoint request failed"
                          cat "$LOG"
                          exit 1
                        }
                        echo "Health response: $HEALTH"
                        echo "$HEALTH" | grep -q UP

                        echo "Checking orders endpoint"
                        ORDERS=$(curl -fsS -u admin:admin123 "localhost:$PORT/api/orders") || {
                          echo "Orders endpoint request failed"
                          cat "$LOG"
                          exit 1
                        }
                        echo "Orders response: $ORDERS"
                        echo "$ORDERS" | grep -q Asha

                        echo "Checking XML endpoint"
                        XML=$(curl -fsS -u admin:admin123 "localhost:$PORT/api/orders/1/xml") || {
                          echo "XML endpoint request failed"
                          cat "$LOG"
                          exit 1
                        }
                        echo "XML response: $XML"
                        echo "$XML" | grep -q '<customerName>'

                        echo "Checking application log for runtime errors"
                        if grep -E "GenerationTarget encountered exception|APPLICATION FAILED" "$LOG"; then
                          cat "$LOG"
                          exit 1
                        fi
                      '''
                    }
                  }
                } catch (Exception e) {
                  echo "Build, test, or smoke failed for ${JAVA_TOOL}: ${e.message}"
                  throw e
                }
              }
            }
            post {
              failure {
                echo "The ${JAVA_TOOL} branch failed. Console output above shows the last completed step."
                script {
                  def log = "legacy-orders/app-${JAVA_TOOL}.log"
                  if (fileExists(log)) {
                    echo "Last 200 lines of ${log}:"
                    sh "tail -n 200 '${log}'"
                  } else {
                    echo "No application log was created; the failure occurred during tool setup, build, or test."
                  }
                }
              }
              always {
                dir('legacy-orders') {
                  sh '''
                    if [ -f "app-$JAVA_TOOL.pid" ]; then
                      kill "$(cat "app-$JAVA_TOOL.pid")" 2>/dev/null || true
                    fi
                  '''
                  junit allowEmptyResults: true, testResults: 'target/surefire-reports/*.xml'
                  archiveArtifacts artifacts: 'app-*.log', allowEmptyArchive: true
                }
              }
            }
          }
        }
      }
    }
  }
}