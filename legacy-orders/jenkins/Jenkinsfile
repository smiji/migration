// Build once on JDK 8, then run the SAME jar on JDK 8 and on JDK 17.
// Sequential stages, so the console log reads top to bottom.
// Tool names must match Manage Jenkins > Tools exactly: jdk8, jdk17, maven3.

pipeline {
  agent any

  stages {

    stage('Build and test (JDK 8)') {
      steps {
        script {
          def jdkHome = toolHome('jdk8')
          def mvnHome = tool name: 'maven3', type: 'hudson.tasks.Maven$MavenInstallation'
          withEnv(["JAVA_HOME=${jdkHome}", "PATH+JDK=${jdkHome}/bin", "PATH+MVN=${mvnHome}/bin"]) {
            dir('legacy-orders') {
              sh 'java -version && mvn -version'
              sh 'mvn -B clean verify'
            }
          }
        }
      }
      post {
        always {
          junit allowEmptyResults: true, testResults: 'legacy-orders/target/surefire-reports/*.xml'
        }
      }
    }

    stage('Smoke test on JDK 8') {
      steps {
        script { smokeTest('jdk8', 18080) }
      }
    }

    stage('Smoke test on JDK 17') {
      steps {
        // Findings on 17 are expected while migrating. Mark the stage failed,
        // but keep the pipeline going so the JDK 8 result stays visible.
        catchError(buildResult: 'UNSTABLE', stageResult: 'FAILURE') {
          script { smokeTest('jdk17', 18017) }
        }
      }
    }
  }
}

// Resolve a JDK tool and fail loudly if Jenkins returns an empty path.
def toolHome(String name) {
  def home = tool name: name, type: 'jdk'
  if (!home?.trim()) {
    error "JDK tool '${name}' resolved to an EMPTY path. Check Manage Jenkins > Tools > JDK installations: " +
          "'Install automatically' must be ticked and an installer (e.g. adoptium.net) with a version selected."
  }
  echo "${name} -> ${home}"
  return home
}

// Start the already-built jar on the given JDK and hit a few endpoints.
def smokeTest(String jdkName, int port) {
  def jdkHome = toolHome(jdkName)
  withEnv(["JAVA_HOME=${jdkHome}", "PATH+JDK=${jdkHome}/bin", "PORT=${port}", "TAG=${jdkName}"]) {
    dir('legacy-orders') {
      try {
        sh '''
          set -eu
          java -version
          LOG="app-$TAG.log"

          java -jar target/legacy-orders-1.0.0.jar --server.port="$PORT" > "$LOG" 2>&1 &
          echo $! > "app-$TAG.pid"

          READY=false
          for i in $(seq 1 30); do
            if curl -fsS "localhost:$PORT/actuator/health" 2>/dev/null | grep -q UP; then
              READY=true
              break
            fi
            kill -0 "$(cat "app-$TAG.pid")" 2>/dev/null || break
            sleep 2
          done
          [ "$READY" = "true" ] || { echo "App did not become healthy on $TAG"; exit 1; }

          echo "--- health"
          curl -fsS "localhost:$PORT/actuator/health"; echo

          echo "--- orders"
          curl -fsS -u admin:admin123 "localhost:$PORT/api/orders" | grep -q Asha

          echo "--- xml (JAXB)"
          curl -fsS -u admin:admin123 "localhost:$PORT/api/orders/1/xml" | grep -q "<customerName>"

          echo "--- ref (sun.misc.BASE64Encoder)"
          curl -fsS -u admin:admin123 "localhost:$PORT/api/orders/1/ref"; echo

          if grep -E "GenerationTarget encountered exception|APPLICATION FAILED" "$LOG"; then
            exit 1
          fi
          echo "Smoke test passed on $TAG"
        '''
      } catch (err) {
        sh 'tail -n 100 "app-$TAG.log" || true'
        throw err
      } finally {
        sh 'if [ -f "app-$TAG.pid" ]; then kill "$(cat "app-$TAG.pid")" 2>/dev/null || true; fi'
        archiveArtifacts artifacts: 'app-*.log', allowEmptyArchive: true
      }
    }
  }
}